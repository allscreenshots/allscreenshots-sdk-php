{
  "name": "allscreenshots/sdk",
  "description": "Capture websites, manage jobs, compose images, schedule captures, crawl sites, and read usage.",
  "keywords": [
    "openapitools",
    "openapi-generator",
    "openapi",
    "php",
    "sdk",
    "rest",
    "api"
  ],
  "homepage": "https://allscreenshots.com",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Allscreenshots",
      "homepage": "https://allscreenshots.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^1.7 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.0 || ^9.0",
    "friendsofphp/php-cs-fixer": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "Allscreenshots\\Sdk\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Allscreenshots\\Sdk\\Test\\": "test/"
    }
  }
}
